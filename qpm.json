{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "QuestBloom",
    "id": "questbloom",
    "version": "0.1.3",
    "url": null,
    "additionalData": {
      "overrideSoName": "libquestbloom.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "pwsh ./scripts/package.ps1"
      ]
    },
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./QuestBloom.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "=6.4.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "=0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "custom-types",
      "versionRange": "=0.18.4",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "=4008.0.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "=0.4.55",
      "additionalData": {}
    }
  ]
}
